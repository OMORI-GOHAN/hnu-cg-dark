{
    "manifest_version": 3,
    "name": "HNU CG Dark",
    "version": "0.1.0",
    "description": "Dark theme for Hunan University CourseGrading.",
    "content_scripts": [
        {
            "matches": [
                "https://cg.hnu.edu.cn/*"
            ],
